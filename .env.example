# Database Connection (Default: local SQLite for development, or PostgreSQL for Neon.tech / Supabase)
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js Configuration
AUTH_SECRET="super-secret-auth-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Admin Access Email (STRICT: Only this Google email is permitted to log into /admin)
ADMIN_EMAIL="owner@gmail.com"

# Google OAuth Credentials (for Admin Login)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Telegram Bot Notifications for Table Reservations (Optional)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_CHAT_ID="-100123456789"
